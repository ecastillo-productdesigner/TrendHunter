  "families": [
    {
      "name": "Bookmark",
      "group": "Navigation and saved",
      "note": "Outlined when inactive; filled lime when saved. Story and profile: 32px. Article: 20px. Story hover and keyboard focus turn white, for both saved and unsaved states. The story glyph is 20px wide, aligned with Share. Article/profile follow the theme and use a separate outline layer in light mode.",
      "states": [
        "Inactive \u00b7 not saved",
        "Active \u00b7 saved",
        "Story hover / focus \u00b7 white"
      ]
    },
    {
      "name": "Profile",
      "group": "Navigation and saved",
      "note": "24px slot with a 16px glyph. Outline off-page; filled lime on the personal profile page.",
      "states": [
        "Inactive",
        "Active \u00b7 current page"
      ]
    },
    {
      "name": "Daily Predictions shortcut",
      "group": "Navigation and saved",
      "note": "24px Material Symbols Outlined bolt. FILL 0 inactive; FILL 1 and lime active. The navigation shortcut is mobile/tablet only.",
      "states": [
        "Inactive",
        "Active \u00b7 current page"
      ]
    },
    {
      "name": "Menu",
      "group": "Navigation and saved",
      "note": "20px. The menu glyph has dark and light theme assets; opening the drawer does not change its shape.",
      "states": [
        "Default \u00b7 follows theme"
      ]
    },
    {
      "name": "Theme toggle",
      "group": "Navigation and saved",
      "note": "24px. Sun switches to light theme; moon switches to dark theme.",
      "states": [
        "Dark \u00b7 sun",
        "Light \u00b7 moon"
      ]
    },
    {
      "name": "Back",
      "group": "Navigation and saved",
      "note": "20px. Authentication navigation.",
      "states": [
        "Default"
      ]
    },
    {
      "name": "Share",
      "group": "Sharing",
      "note": "Crisp SVG on every card. Story slot: 30px with a 20px-wide arrow aligned to Bookmark; prediction: 24px at top right. Default matches the unsaved bookmark, including its light-theme color. Hover and keyboard focus turn white without a background; the open share menu keeps its icon #BEFC4F, including while hovered. Article: 20px; Answers: 16px. Opening the menu keeps the glyph; on prediction cards it flips with the card face.",
      "states": [
        "Default \u00b7 bookmark color",
        "Hover / keyboard focus \u00b7 white",
        "Active \u00b7 menu open \u00b7 #BEFC4F"
      ]
    },
